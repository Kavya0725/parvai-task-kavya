	)
	(text "MPU6050 Sensor"
		(exclude_from_sim no)
		(at 181.61 -25.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.032 2.032)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "514cb072-fd58-468d-bdc6-2d05baa6514a")
	)
	(text "*PullUp Resistor"
		(exclude_from_sim no)
		(at 48.768 103.124 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6ee58a88-04a2-4036-97fb-84ef33c7908f")
	)
	(text "-The AMS1117-3.3 regulator is used to convert the battery voltage \n into a stable 3.3V supply.\n-10µF capacitors are connected at the input and output for voltage \n stabilization.\n-An additional 100nF capacitor is added at the output for high-frequency\n noise filtering.\n-The regulated 3.3V output powers both the ESP32 and MPU6050 sensor."
		(exclude_from_sim no)
		(at 215.9 -45.72 0)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "8534a204-b13e-4019-994c-8a2428e80733")
	)
	(text "Lipo Battery"
		(exclude_from_sim no)
		(at 40.132 16.764 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.3302)
				(bold yes)
			)
		)
		(uuid "98856702-a9d7-427d-be12-e93e75c93deb")
	)
	(text "Schematic Notes"
		(exclude_from_sim no)
		(at 139.7 -66.04 0)
		(effects
			(font
				(face "Arial Black")
				(size 5.08 5.08)
				(thickness 0.254)
				(bold yes)
				(color 87 0 255 1)
			)
		)
		(uuid "9b379f8c-0393-4b8f-8741-6e62b5952525")
	)
	(text "ESP32 Sensor Processing Unit"
		(exclude_from_sim no)
		(at 97.79 82.804 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "9d0a3ca0-c2ae-4124-8651-ebecad446279")
	)
	(text "TP4056 Charging Circuit"
		(exclude_from_sim no)
		(at 143.51 -55.88 0)
		(effects
			(font
				(face "Arial")
				(size 2.032 2.032)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "a65dea2e-751b-42d6-97d7-4edc8edbbf15")
	)
	(text "-The TP4056 IC is used for safe charging of the single-cell LiPo battery.\n-A 2.0 kΩ resistor is connected to the PROG pin to set the charging \n current to approximately 580mA.\n-10µF capacitors are added near the input and battery output for voltage\n stabilization and noise reduction during charging."
		(exclude_from_sim no)
		(at 141.224 -46.99 0)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "c3a2f36b-21f8-4410-889f-3091122bc61c")
	)
	(text "ESP32 Module"
		(exclude_from_sim no)
		(at 96.52 -26.67 0)
		(effects
			(font
				(face "Arial")
				(size 2.032 2.032)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "d0c3e153-4b0a-4cf4-ae97-dfa2f8b872f9")
	)
	(text "-The ESP32 acts as the main microcontroller for sensor processing \n and embedded control.\n-A 10kΩ pull-up resistor is connected to the EN pin to keep the ESP32\n enabled during operation.\n-10µF and capacitor is added near the power pins for stable \n operation and noise reduction.\n-The ESP32 communicates with the MPU6050 using the I2C protocol."
		(exclude_from_sim no)
		(at 97.536 -15.494 0)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "f4c48d00-4669-48c3-b030-f13ee8a0f9d2")
	)
