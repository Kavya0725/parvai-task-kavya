	(text "Charging Circuit"
		(exclude_from_sim no)
		(at 166.37 16.764 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "016870ab-3149-49bf-a967-d3d2b1c3e5fd")
	)
	(text "-The sensor communicates with the ESP32 through the SDA and SCL I2C \n communication lines.\n-4.7kΩ pull-up resistors are used on the SDA and SCL lines for stable\n I2C communication.\n-A 100nF decoupling capacitor is connected near the VCC pin to reduce\n noise.\n-Additional capacitors connected to the REGOUT and CPOUT pins are added\n according to the MPU6050 datasheet recommendations."
		(exclude_from_sim no)
		(at 179.832 -12.954 0)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(thickness 0.1588)
				(bold yes)
			)
		)
		(uuid "054ace57-1a25-4c3a-9d34-ae0d6a8486b3")
	)
	(text "\n-The USB-C connector is used as the 5V input source for the charging circuit.\n-5.1kΩ resistors are connected to the CC1 and CC2 pins for proper USB-C power detection.\n-Only the VBUS and GND lines are used since the USB connection is intended mainly for charging."
		(exclude_from_sim no)
		(at 20.066 -49.784 0)
		(effects
			(font
				(face "Arial")
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "18033df4-608e-44ea-b864-99665ee24204")
	)
	(text "AMS1117-3.3 Voltage Regulator"
		(exclude_from_sim no)
		(at 215.9 -55.626 0)
		(effects
			(font
